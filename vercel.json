{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/consultation",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/ax",
      "permanent": true
    },
    {
      "source": "/business",
      "destination": "/ax/cases",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/healthcare",
      "destination": "/healthcare/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/insights",
      "destination": "/insights/index.html"
    },
    {
      "source": "/ax",
      "destination": "/ax/index.html"
    },
    {
      "source": "/ax/medical",
      "destination": "/ax/medical/index.html"
    },
    {
      "source": "/ax/cases",
      "destination": "/ax/cases/index.html"
    },
    {
      "source": "/ax/medical/jeju",
      "destination": "/ax/medical/jeju/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/report/:slug",
      "destination": "/report/:slug/index.html"
    },
    {
      "source": "/reports/weekly/:slug",
      "destination": "/reports/weekly/:slug/index.html"
    },
    {
      "source": "/reports/business/:slug",
      "destination": "/reports/business/:slug/index.html"
    },
    {
      "source": "/reports/:slug",
      "destination": "/reports/:slug/index.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/research/:slug/index.html"
    },
    {
      "source": "/disease/:slug",
      "destination": "/disease/:slug/index.html"
    },
    {
      "source": "/insights/report/202602",
      "destination": "/insights/report/202602/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/images/optimized-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/editorial-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/service-photos-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/spacecare-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/spacecare-v2/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/spacelink-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/gaax-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/happycare-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
